{
  "version": 1,
  "hooks": {
    "userPromptSubmitted": [
      { "type": "command", "bash": "python3 scripts/spendlens.py prompt copilot", "powershell": "python scripts\\spendlens.py prompt copilot", "timeoutSec": 10 },
      { "type": "command", "bash": "python3 scripts/handoff.py arm copilot", "powershell": "python scripts\\handoff.py arm copilot", "timeoutSec": 10 }
    ],
    "postToolUse": [
      { "type": "command", "bash": "python3 scripts/spendlens.py tool copilot", "powershell": "python scripts\\spendlens.py tool copilot", "timeoutSec": 10 }
    ],
    "sessionEnd": [
      { "type": "command", "bash": "python3 scripts/spendlens.py finalize copilot", "powershell": "python scripts\\spendlens.py finalize copilot", "timeoutSec": 20 },
      { "type": "command", "bash": "python3 scripts/handoff.py end copilot", "powershell": "python scripts\\handoff.py end copilot", "timeoutSec": 20 }
    ]
  }
}
